;; ----- lower
(decl partial lower (Inst) InstOutput)

;; ----- lower special
(rule (lower (iconst ty (u64_from_imm64 n)))
  (imm ty n))
(rule (lower (return args))
  (lower_return args))

;; ----- lower AluRR
(rule (lower (iadd ty a b))
  (spv_iadd ty a b))
(rule (lower (isub ty a b))
  (spv_isub ty a b))
(rule (lower (imul ty a b))
  (spv_imul ty a b))



;; lower_branch
(decl partial lower_branch (Inst MachLabelSlice) Unit)
(rule (lower_branch (jump block_call) (single_target label))
  (emit_side_effect (spv_jump label (block_call_uses block_call))))
